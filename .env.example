OPENCODE_API_KEY=
JEV_API_KEY=

# Models by role; endpoints, key variables, limits and prices are in
# src/verification2/core/models.yaml.
VERIFIER_MODEL=qwen3.8-flash
SOLVER_MODEL=qwen3.8-flash
JEV_MODEL=typesafe-ai/jev

# Reasoning level per role; empty uses the model's default_reasoning_effort in
# models.yaml (medium). Allowed values are its reasoning_efforts (qwen3.8-flash:
# none, low, medium, xhigh; glm-5.3-flash: none, low, medium, high, max); none
# turns reasoning off, so a solver with none has no R evidence and fails the pilot.
# The solver level applies to the solver agent, not the tau2 user simulator.
SOLVER_REASONING_EFFORT=
VERIFIER_REASONING_EFFORT=

TAU2_ROOT=raw/tau2-bench

# make web-setup writes local website URLs to raw/websites/.env automatically.
# To use existing benchmark services, uncomment and fill in their native URLs:
# WA_HOMEPAGE=http://127.0.0.1:4399
# WA_SHOPPING=http://127.0.0.1:8082
# WA_SHOPPING_ADMIN=http://127.0.0.1:8083/admin
# WA_REDDIT=http://127.0.0.1:8080
# WA_GITLAB=http://127.0.0.1:8023
# WA_WIKIPEDIA=http://127.0.0.1:8081/wikipedia_en_all_maxi_2022-05/A/User:The_other_Kiwix_guy/Landing
# WA_MAP=http://127.0.0.1:3000
# WA_FULL_RESET=http://127.0.0.1:7565
